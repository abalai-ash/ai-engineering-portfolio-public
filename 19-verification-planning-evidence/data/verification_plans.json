    ],
    "acceptance_criteria": {
      "metric": "correct_state_count",
      "operator": "==",
      "threshold": 2
    },
    "required_evidence_fields": [
      "demonstration_id",
      "observed_states",
      "metric_value",
      "reviewer"
    ]
  },
  {
    "id": "VP-005",
    "requirement_ids": [
      "REQ-005"
    ],
    "objective": "Verify anomaly-based closure blocking.",
